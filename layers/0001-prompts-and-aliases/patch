+        | SessionSource::VSCode
+        | SessionSource::Exec
+        | SessionSource::Mcp
+        | SessionSource::Custom(_)
+        | SessionSource::Internal(_)
+        | SessionSource::Unknown => load_root_agent_prompt(&config.codex_home).await,
+    };
+
+    if role_prompt.trim().is_empty() {
+        None
+    } else {
+        Some(role_prompt)
+    }
