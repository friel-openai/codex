+        reads.iter().all(|params| params["includeTurns"] != true),
+        "durable fork import requested full history: {reads:?}"
+    );
+
+    receiver.shutdown().await?;
+    source.shutdown().await?;
+    proxy.await??;
+    Ok(())
+}
