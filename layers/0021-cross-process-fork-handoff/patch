+                    codex_rollout::RolloutLine {
+                        timestamp: String::new(),
+                        ordinal: None,
+                        item: codex_rollout::RolloutItem::SessionMeta(
+                            frozen.source_session_meta.clone(),
+                        ),
+                    },
+                    codex_rollout::RolloutLine {
+                        timestamp: String::new(),
+                        ordinal: None,
+                        item: codex_rollout::RolloutItem::RolloutReference(
+                            frozen.reference.clone(),
