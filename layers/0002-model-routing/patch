+fn untagged_assistant_item_added(item_id: &str) -> Value {
+    json!({
+        "type": "response.output_item.added",
+        "item": {
+            "type": "message",
+            "role": "assistant",
+            "id": item_id,
+            "content": [{"type": "output_text", "text": ""}]
