+async fn maybe_run_model_reroute_inline_compact(
+    sess: &Arc<Session>,
+    previous_turn_context: &Arc<TurnContext>,
+    routed_step_context: &Arc<StepContext>,
+    world_state: &Arc<WorldState>,
+    client_session: &mut ModelClientSession,
