+    fn body(&self) -> ContentItem {
+        input_text(
+            "\nThe preceding provider response ended before it completed. Any incomplete tool call recorded with a failure output was not executed. No unfinished provider-managed operation should be assumed successful.\n",
+        )
+    }
+}
