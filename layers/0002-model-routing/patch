+#[tokio::test]
+async fn routed_profile_falls_back_after_tool_continuation_failure() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let plan_args = serde_json::json!({
+        "explanation": "Record the routing checkpoint",
