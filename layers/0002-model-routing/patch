+fn append_partial_assistant_text(active_item: &mut Option<ResponseItem>, delta: &str) {
+    let Some(ResponseItem::Message { role, content, .. }) = active_item.as_mut() else {
+        return;
+    };
+    if role != "assistant" || delta.is_empty() {
+        return;
+    }
