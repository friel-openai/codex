+        );
+        assert!(recover_legacy_jsonl_suffix(format!("{{broken{reference}").as_bytes()).is_none());
+        assert!(
+            recover_legacy_jsonl_suffix(format!("{{broken{ordinary}{reference}").as_bytes())
+                .is_none()
+        );
+    }
