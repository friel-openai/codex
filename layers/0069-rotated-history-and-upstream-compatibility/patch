+fn same_walked_prefix(left: &RolloutLineage, right: &RolloutLineage) -> bool {
+    left.root_rollout_id() == right.root_rollout_id()
+        && left.leaf_path() == right.leaf_path()
+        && left
+            .segments()
+            .iter()
+            .rev()
+            .zip(right.segments().iter().rev())
+            .all(|(left, right)| left == right)
+}
