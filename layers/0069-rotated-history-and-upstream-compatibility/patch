+    {
+        drop(transaction);
+        return Ok(LazyPage::Full(walk.resolve_full().await?));
+    }
+    transaction.commit().await.map_err(thread_history_error)?;
+    Ok(LazyPage::Page(
+        finish_page(
+            params.thread_id,
+            root_rollout_id,
+            CursorScope::ItemsByCreatedAtOrdinal,
+            rows,
+            params.page_size,
+        )?,
+        walk.into_lineage(),
+    ))
