+        vec![MODEL_A, MODEL_B, MODEL_B]
+    );
+    assert_eq!(bodies[1]["reasoning"]["summary"], "concise");
+    assert_eq!(bodies[2]["reasoning"]["summary"], "detailed");
+    assert_eq!(test.codex.thread_settings_snapshot().await, future_settings);
+    Ok(())
+}
