+                1 => turn_items.extend([
+                    subagent_activity_item(STALE_ACTIVITY_ID, stale_agent_id, "stale"),
+                    collab_item(
+                        STALE_SPAWN_ID,
+                        CollabAgentTool::SpawnAgent,
