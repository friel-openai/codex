+                ]),
+                2 => turn_items.extend([
+                    subagent_activity_item(BOUNDARY_ACTIVITY_ID, boundary_agent_id, "boundary"),
+                    collab_item(
+                        BOUNDARY_SPAWN_ID,
+                        CollabAgentTool::SpawnAgent,
+                        thread_id,
+                        vec![boundary_agent_id],
