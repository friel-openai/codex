+            rollout_items.extend(turn_items.into_iter().map(|item| {
+                RolloutItem::EventMsg(EventMsg::ItemCompleted(ItemCompletedEvent {
+                    thread_id,
+                    turn_id: turn_id.clone(),
+                    item,
+                    started_at_ms: Some(0),
