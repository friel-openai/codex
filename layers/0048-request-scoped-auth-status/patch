+    harness
+        .processor
+        .process_request(
+            connection,
+            request_from_client_request(ClientRequest::Initialize {
+                request_id: RequestId::Integer(3),
+                params: InitializeParams {
+                    client_info: ClientInfo {
+                        name: "retrying-client".to_string(),
+                        title: None,
+                        version: "0.1.0".to_string(),
