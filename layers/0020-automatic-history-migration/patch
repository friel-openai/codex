+            .expect("publish corrected projection")
+    );
+    let selected = thread_rollout_resolver::resolve_current(&store, thread_id)
+        .await
+        .expect("resolve corrected source")
+        .expect("corrected selection");
+    assert_eq!(selected.path, corrected_path);
