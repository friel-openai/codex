+#[test_case(false, true; "root with excluded legacy baseline")]
+#[test_case(true, false; "worker without baseline")]
+#[test_case(true, true; "worker with excluded legacy baseline")]
+fn independent_review_input_preserves_original_envelopes(
+    source_is_non_root_agent: bool,
+    with_baseline: bool,
+) {
+    use codex_history::CodexHarnessMetadata;
+    use codex_history::GuardianHistoryCheckpoint;
+    use codex_history::ReviewInputRecord;
+    use codex_history::ReviewTranscriptApplicability;
+    use codex_utils_output_truncation::TruncationPolicy;
+
+    let retained = ResponseItemEnvelope {
+        item: user_message("Retain this instruction"),
+        metadata: Some(CodexHarnessMetadata {
+            user_input_order: Some(1),
+            ..Default::default()
+        }),
+    };
+    let late_assistant = ResponseItemEnvelope {
+        item: assistant_message("Accepted after the removed instruction"),
+        metadata: Some(CodexHarnessMetadata {
+            user_input_order: Some(3),
+            ..Default::default()
+        }),
+    };
+    let removed = ResponseItemEnvelope {
+        item: user_message("Remove this instruction"),
+        metadata: Some(CodexHarnessMetadata {
+            user_input_order: Some(2),
+            ..Default::default()
+        }),
+    };
+    let originals = vec![retained.clone(), late_assistant];
+    let mut records = if with_baseline {
+        vec![ReviewInputRecord::Baseline {
+            applicability: ReviewTranscriptApplicability::Legacy,
+            history: GuardianHistoryCheckpoint(originals),
+            root_retains_legacy_transcript: Some(false),
+        }]
+    } else {
+        originals
+            .into_iter()
+            .map(|response| ReviewInputRecord::ResponseItem { response })
+            .collect()
+    };
+    records.push(ReviewInputRecord::ResponseItem {
+        response: removed.clone(),
+    });
+    records.push(ReviewInputRecord::Rollback {
+        boundary: removed.item,
+        boundary_metadata: removed.metadata,
+    });
+
+    let history = super::rollout_reconstruction::replay_review_input(
+        &records,
+        TruncationPolicy::Tokens(1_000),
+        source_is_non_root_agent,
+        GuardianContextMode::Independent,
+    )
+    .expect("independent replay always has its own transcript");
+    assert_eq!(
+        history.checkpoint(),
+        GuardianHistoryCheckpoint(vec![retained])
+    );
+}
