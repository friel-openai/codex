+            &[RolloutItem::SessionMeta(SessionMetaLine {
+                meta: SessionMeta {
+                    id: child_thread_id,
+                    session_id: SessionId::from(child_thread_id),
+                    history_mode: ThreadHistoryMode::Paginated,
+                    history_base: Some(HistoryPosition {
+                        thread_id: source_rollout_id,
