+    assert_eq!(next_cursor, None);
+    let items = data
+        .iter()
+        .flat_map(|turn| {
+            turn.items.iter().map(|item| {
+                Ok((
+                    turn.id.clone(),
+                    item.id().to_string(),
+                    serde_json::to_vec(item)?,
