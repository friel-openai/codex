+fn plan_review_input_target(
+    codex_home: &Path,
+    sources: &[LegacyLineageSource],
+    authentication_sources: &[LegacyLineageSource],
+    history_bases: &[LegacyHistoryBaseDependency],
+    reference_dependencies: &[LegacyReferenceDependency],
+) -> ThreadStoreResult<Option<LegacyLineageTarget>> {
+    if !sources.iter().any(|source| source.has_rollback) {
+        return Ok(None);
+    }
+    let mut hasher = Sha256::new();
+    hasher.update(b"frodex-review-input-v1\0");
+    for source in sources.iter().chain(authentication_sources) {
+        hasher.update(source.thread_id.to_string().as_bytes());
+        hasher.update(source.rollout_id.to_string().as_bytes());
+        hasher.update(source.sha256.as_bytes());
+        hasher.update(serde_json::to_vec(&source.replay_end).map_err(migration_error)?);
+        hasher.update(serde_json::to_vec(&source.native_replay).map_err(migration_error)?);
+        hasher.update(b"\0");
+    }
+    for dependency in history_bases {
+        hasher.update(serde_json::to_vec(&dependency.position).map_err(migration_error)?);
+        hasher.update(dependency.sha256.as_bytes());
+        hasher.update(b"\0");
+    }
+    for dependency in reference_dependencies {
+        hasher.update(dependency.rollout_id.to_string().as_bytes());
+        hasher.update(dependency.end_ordinal_exclusive.to_le_bytes());
+        hasher.update(dependency.end_byte_offset.to_le_bytes());
+        hasher.update(dependency.sha256.as_bytes());
+        hasher.update(b"\0");
+    }
+    let rollout_id = ThreadId::from_u128(u128::from_be_bytes(
+        hasher.finalize()[..16]
+            .try_into()
+            .map_err(|_| migration_error("invalid review-input identity digest"))?,
+    ));
+    Ok(Some(LegacyLineageTarget {
+        thread_id: rollout_id,
+        rollout_id,
+        segment_id: Some(SegmentId::from_string(&rollout_id.to_string()).map_err(migration_error)?),
+        path: codex_rollout::review_input_segment_path(codex_home, rollout_id),
+        selected: false,
+        predecessor_segment_id: None,
+    }))
