+fn turn(id: &str, status: TurnStatus) -> ThreadHistoryChangeSet {
+    ThreadHistoryChangeSet {
+        changed_turns: vec![ThreadHistoryTurnMetadata {
+            turn_id: id.to_string(),
+            root_turn_id: None,
