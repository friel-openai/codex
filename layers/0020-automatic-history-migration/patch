+fn deserialize_rate_limit_used_percent<'de, D>(deserializer: D) -> Result<f64, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    // Tagged event buffering represents arbitrary-precision numbers as Serde's private map,
