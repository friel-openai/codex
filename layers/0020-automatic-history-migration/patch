+    let journal = migration_journal_path(&store.config.codex_home, thread_id);
+    if tokio::fs::try_exists(&journal)
+        .await
+        .map_err(migration_error)?
+    {
+        return Ok(false);
+    }
+    if rollout_fingerprint(path).await? != source_fingerprint {
+        return Ok(false);
