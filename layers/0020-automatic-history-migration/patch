+        bytes.push(b'\n');
+    }
+    // An escaped JSON key is conservatively parsed rather than silently skipped.
+    bytes.extend_from_slice(br#"{"timestamp":"2026-08-20T00:00:00Z","ordinal":4,"type":"event_msg","payload":{"\u0074ype":"turn_complete","turn_id":"turn"}}"#);
