+#[tokio::test]
+async fn ordinal_recovery_does_not_deadlock_repair_behind_queued_archive() {
+    let home = TempDir::new().expect("temporary home");
+    let (store, thread_id, source_path, source_bytes) = fixture(home.path()).await;
+    let selected = thread_rollout_resolver::resolve_current(&store, thread_id)
+        .await
+        .expect("resolve")
+        .expect("selected");
+    let metadata = codex_rollout::read_session_meta_line(&source_path)
+        .await
+        .expect("metadata");
+    let expected = correct_reused_ordinals(&source_bytes, &metadata).expect("corrected bytes");
+    let repair_lifecycle = store.live_writer_locks.reserve_lifecycle(thread_id).await;
+
+    // Poll the exact lifecycle acquisition used by archive before polling recovery. Tokio's
+    // writer preference must keep recovery's later reader behind this queued writer.
+    let mut archive = Box::pin(tokio::task::unconstrained(
+        store.live_writer_locks.lock_lifecycle(thread_id),
+    ));
+    assert!(futures::poll!(archive.as_mut()).is_pending());
+    let mut recovery = Box::pin(tokio::task::unconstrained(prepare(
+        &store, &selected, &metadata,
+    )));
+    assert!(futures::poll!(recovery.as_mut()).is_pending());
+
+    // Uncontended maintenance acquisition completes on prepare's first poll. The old order
+    // therefore held shared maintenance here, closing the repair/archive/recovery wait cycle.
+    let repair_maintenance = codex_rollout::try_acquire_rollout_maintenance_lock(home.path())
+        .expect("reserve repair maintenance")
+        .expect("recovery must not hold maintenance while queued behind archive");
+    assert_eq!(
+        fs::read(&source_path).expect("original source"),
+        source_bytes
+    );
+    drop(repair_maintenance);
+    drop(repair_lifecycle);
+
+    let archive_lifecycle = archive.await;
+    assert!(
+        futures::poll!(recovery.as_mut()).is_pending(),
+        "recovery must still respect archive's exclusive lifecycle ownership"
+    );
+    drop(archive_lifecycle);
+    let recovered = recovery
+        .await
+        .expect("recovery resumes after archive")
+        .expect("prepared ordinal correction");
+    let corrected_path = recovered.rollout_path.clone();
+    assert_eq!(
+        fs::read(&corrected_path).expect("corrected sibling"),
