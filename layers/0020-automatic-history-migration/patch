+#[tokio::test]
+async fn migration_keeps_native_checkpoint_before_frozen_cutoff_despite_parent_rollback() {
+    let home = tempfile::tempdir().expect("isolated CODEX_HOME");
+    let parent_id = ThreadId::new();
+    let view_id = ThreadId::new();
+    let child_id = ThreadId::new();
+    let parent_segment = SegmentId::new();
+    let view_segment = SegmentId::new();
+    let parent = home
+        .path()
+        .join("sessions/2025/01/03")
+        .join(format!("rollout-2025-01-03T12-00-00-{parent_id}.jsonl"));
+    let window_id = uuid::Uuid::now_v7().to_string();
+    let frozen_checkpoint: codex_rollout::CompactedItem =
+        serde_json::from_value(serde_json::json!({
+            "message": "",
+            "replacement_history": [
+                {"type": "message", "role": "user", "content": [
+                    {"type": "input_text", "text": "frozen-A"}
+                ]},
+                {"type": "message", "role": "user", "content": [
+                    {"type": "input_text", "text": "frozen-B"}
+                ]}
+            ],
+            "resume_metadata": {
+                "multi_agent_version": codex_protocol::protocol::MultiAgentVersion::V2,
+                "last_started_turn_id": "frozen-B",
+                "previous_turn_settings": {
+                    "model": "frozen-model",
+                    "comp_hash": "frozen-settings",
+                    "realtime_active": true
+                }
+            },
+            "window_number": 7,
+            "first_window_id": window_id,
+            "window_id": window_id,
+            "compaction_response_id": "frozen-response"
+        }))
+        .expect("modern frozen checkpoint");
+    let mut parent_items = native_model_turn(parent_id, "frozen-A");
+    let mut turn_b = native_model_turn(parent_id, "frozen-B");
+    let completion_b = turn_b.pop().expect("B completion");
+    turn_b.push(RolloutItem::Compacted(frozen_checkpoint.clone()));
+    turn_b.push(completion_b);
+    parent_items.extend(turn_b);
+    let frozen_end = write_paginated_segment(
+        &parent,
+        home.path(),
+        parent_id,
+        parent_segment,
+        0,
+        parent_items.clone(),
+    );
+    let frozen_bytes = fs::read(&parent).expect("frozen prefix bytes");
+    let frozen_end_byte_offset = u64::try_from(frozen_bytes.len()).expect("prefix length");
+
+    // These records are outside the child's selected ordinal and byte boundaries.
+    parent_items.push(RolloutItem::EventMsg(EventMsg::ThreadRolledBack(
+        ThreadRolledBackEvent { num_turns: 1 },
+    )));
+    parent_items.extend(native_model_turn(parent_id, "outside-frozen-prefix"));
+    write_paginated_segment(
+        &parent,
+        home.path(),
+        parent_id,
+        parent_segment,
+        0,
+        parent_items,
+    );
+    assert_eq!(
+        &fs::read(&parent).expect("extended parent")[..frozen_bytes.len()],
+        frozen_bytes.as_slice(),
+        "fixture must preserve the exact bytes before the frozen cutoff"
+    );
+
+    // A native view supplies the bounded history_base that RolloutReference cannot express.
+    let view = home
+        .path()
+        .join("sessions/2025/01/03")
+        .join(format!("rollout-2025-01-03T12-00-01-{view_id}.jsonl"));
+    write_paginated_segment(
+        &view,
+        home.path(),
+        view_id,
+        view_segment,
+        frozen_end,
+        Vec::new(),
+    );
+    set_history_base(
+        &view,
+        HistoryPosition {
+            thread_id: parent_id,
+            end_ordinal_exclusive: frozen_end,
+            end_byte_offset: frozen_end_byte_offset,
+        },
+    );
+    let child = home
+        .path()
+        .join("sessions/2025/01/03")
+        .join(format!("rollout-2025-01-03T12-00-02-{child_id}.jsonl"));
+    let mut child_items = vec![segment_reference(view.clone(), view_id, view_segment)];
+    child_items.extend(turn("child"));
+    write_legacy_segment(&child, home.path(), child_id, SegmentId::new(), child_items);
+    let preserved = [parent, view, child].map(|path| {
+        let bytes = fs::read(&path).expect("source bytes before migration");
+        (path, bytes)
+    });
+    let store = indexed_store(home.path()).await;
+    let report = store
+        .migrate_rollouts(RolloutMigrationOptions {
+            thread_ids: vec![child_id],
+            ..apply_options()
+        })
+        .await
+        .expect("migrate bounded legacy child");
+    assert_eq!(report.outcomes.len(), 1, "{report:?}");
+    assert_eq!(
+        report.outcomes[0].status,
+        RolloutMigrationStatus::Migrated,
+        "{report:?}"
+    );
+    let turns = list_active_summary_turns(&store, child_id).await;
+    assert_eq!(
+        turns
+            .turns
+            .iter()
+            .map(|turn| turn.turn_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["frozen-A", "frozen-B", "child"],
+        "the parent's later rollback must not remove the child's frozen B"
+    );
+    let full = store
+        .load_history(LoadThreadHistoryParams {
+            thread_id: child_id,
+            include_archived: false,
+        })
+        .await
+        .expect("read migrated full history")
+        .items;
+    let bounded = store
+        .load_latest_model_context(LoadThreadHistoryParams {
+            thread_id: child_id,
+            include_archived: false,
+        })
+        .await
+        .expect("read migrated bounded model context")
+        .items;
+    for (reader, items) in [("full", full), ("bounded", bounded)] {
+        let checkpoint = items
+            .iter()
+            .rev()
+            .find_map(|item| match item {
+                RolloutItem::Compacted(checkpoint) => Some(checkpoint),
+                _ => None,
+            })
+            .expect("frozen modern checkpoint");
+        assert_eq!(
+            checkpoint, &frozen_checkpoint,
+            "{reader}: migration changed frozen messages or resume metadata"
+        );
+        assert!(!items.iter().any(|item| matches!(
+            item,
+            RolloutItem::EventMsg(EventMsg::TurnStarted(event))
+                if event.turn_id == "outside-frozen-prefix"
+        )));
+        assert!(
+            !items
+                .iter()
+                .any(|item| matches!(item, RolloutItem::EventMsg(EventMsg::ThreadRolledBack(_))))
+        );
+    }
+    for (path, bytes) in preserved {
+        assert_eq!(fs::read(path).expect("unchanged source bytes"), bytes);
+    }
+}
