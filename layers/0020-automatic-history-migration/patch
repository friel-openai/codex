+            "acceptance_order": 9,
+        }))
+        .expect("retained assistant delivery");
+        let value = serde_json::to_value(RolloutLine {
+            timestamp: "2026-09-23T00:00:00Z".to_string(),
+            ordinal: Some(7),
+            item: RolloutItem::RetainedContext(expected.clone()),
