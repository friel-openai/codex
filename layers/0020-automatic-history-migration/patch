+/// Separates ordinal framing from the tagged payload's canonical JSON deserialization.
+#[derive(Deserialize)]
+struct ReviewInputLine {
+    /// Zero-based position within the immutable segment, including its metadata header.
+    ordinal: u64,
+    record: Value,
+}
