+    let mut eligible = 0_u64;
+    let mut full = Duration::ZERO;
+    let mut cached = Duration::ZERO;
+    let mut cloning = Duration::ZERO;
+    let mut ineligible = Duration::ZERO;
+    for source in &plan.sources {
