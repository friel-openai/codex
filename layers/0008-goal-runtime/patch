+mod tests {
+    use super::*;
+
+    #[test]
+    fn close_self_result_ends_the_supervisor_turn() {
+        let result = SupervisorSelfCloseResult { completed: true };
+
+        assert!(result.terminal_no_response());
+    }
+}
