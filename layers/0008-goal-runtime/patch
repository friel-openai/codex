+    }
+    invalidate_supervisor_wakeup(session).await;
+    *session.goal_supervisor_runtime.snoozed_until.lock().await = None;
+    reset_failure_backoff(session).await;
+    if let Some(state_db) = session.services.state_db.as_ref() {
