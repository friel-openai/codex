+#[test]
+fn cold_daemon_same_id_waiter_can_be_cancelled_without_blocking_another_root() -> Result<()> {
+    run_cold_daemon_test(
+        cold_daemon_same_id_waiter_can_be_cancelled_without_blocking_another_root_inner,
+    )
+}
