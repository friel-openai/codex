+                    fs::read(pending).expect("published empty marker"),
+                    Vec::<u8>::new()
+                );
+            } else {
+                assert_eq!(
+                    parse_lineage_migration_journal(&fs::read(pending).expect("published journal"))
+                        .expect("typed journal"),
+                    manifest
+                );
+            }
+        }
+    });
