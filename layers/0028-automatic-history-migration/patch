+fn response(text: &str) -> RolloutItem {
+    serde_json::from_value(serde_json::json!({"type":"response_item","payload":{
+        "type":"message","role":"user","content":[{"type":"input_text","text":text}]
+    }}))
+    .expect("user response")
+}
+
+fn turn(id: &str) -> Vec<RolloutItem> {
+    vec![
+        turn_started(id),
+        response(id),
+        user_message(id),
+        turn_complete(id),
+    ]
+}
+
+fn turn_with_retained_answer(id: &str, call_id: &str, answer: &str) -> Vec<RolloutItem> {
+    let call = serde_json::from_value(serde_json::json!({
+        "type": "response_item",
+        "payload": {
+            "type": "function_call",
+            "name": "request_user_input",
+            "arguments": "{}",
+            "call_id": call_id
+        }
+    }))
+    .expect("request_user_input call");
+    let answer = serde_json::from_value(serde_json::json!({
+        "type": "verified_answer",
+        "turn_id": id,
+        "call_id": call_id,
+        "questions": [{"question": "Publish?", "answer": answer}]
+    }))
+    .expect("verified answer");
+    vec![
+        turn_started(id),
+        response(id),
+        user_message(id),
+        call,
+        RolloutItem::RetainedContext(answer),
+        turn_complete(id),
+    ]
+}
+
+fn native_turn(thread_id: ThreadId, id: &str) -> Vec<RolloutItem> {
+    let item = completed_user_message(thread_id, id, &format!("explicit-{id}"), id);
+    vec![turn_started(id), item.clone(), item, turn_complete(id)]
+}
+
+fn native_model_turn(thread_id: ThreadId, id: &str) -> Vec<RolloutItem> {
+    vec![
+        turn_started(id),
+        response(id),
+        completed_user_message(thread_id, id, &format!("explicit-{id}"), id),
