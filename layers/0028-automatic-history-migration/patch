+                "staged file ended before generated item ID range",
+            ));
+        }
+        hasher.update(&buffer[..read]);
+        writer
+            .write_all(&buffer[..read])
+            .await
+            .map_err(migration_error)?;
+        remaining -= read as u64;
+    }
+    Ok(())
+}
