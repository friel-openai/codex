+    let harness = AgentControlHarness::new().await;
+    let state_db = harness.state_db.as_ref().expect("persisted goals");
+    let (parent_id, parent) = harness.start_thread().await;
+    let (goal_id, goal) = create_active_thread_goal_for_test(
