+fn matches_thread(request: &wiremock::Request, id: &str) -> bool {
+    ["thread-id", "x-client-request-id"].into_iter().any(|key| {
+        request
+            .headers
+            .get(key)
+            .and_then(|value| value.to_str().ok())
+            == Some(id)
+    })
+}
