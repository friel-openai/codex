+            ContentItem::InputText { text } => text
+                .strip_prefix("# Goal Supervisor Continuity\n\n")
+                .map(|json| serde_json::from_str(json).expect("continuity JSON")),
+            _ => None,
+        })
+        .expect("continuity text")
