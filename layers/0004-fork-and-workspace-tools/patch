+fn build_ghostty_spawn_config(
+    exe: &Path,
+    thread_id: &ThreadId,
+    config: &Config,
+    additional_writable_roots: &[PathBuf],
+    placement: ForkPanePlacement,
+) -> Result<GhosttySpawnConfig, String> {
