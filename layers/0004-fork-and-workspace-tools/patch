+fn ghostty_fork_usage_for_platform(
+    terminal_info: &TerminalInfo,
+    platform_supported: bool,
+) -> Option<&'static str> {
+    (platform_supported
+        && terminal_info.multiplexer.is_none()
+        && terminal_info.name == TerminalName::Ghostty)
+        .then_some(GHOSTTY_FORK_USAGE)
