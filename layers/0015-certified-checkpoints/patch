+/// Validates persisted profile roots without resolving foreign paths on the current host.
+fn deserialize_profile_workspace_roots<'de, D>(
+    deserializer: D,
+) -> Result<Option<Vec<LegacyAppPathString>>, D::Error>
+where
+    D: Deserializer<'de>,
