+    assert_eq!(reconstructed.retained_context, expected);
+    assert_eq!(
+        reconstructed.retained_context.user_messages_complete(),
+        !missing_retained_boundary
+    );
+    assert!(reconstructed.retained_context.verified_answers_complete());
+}
