+#[derive(Deserialize)]
+struct RawSessionEnvelope<'a> {
+    #[serde(borrow)]
+    payload: &'a RawValue,
+}
+
+#[derive(Deserialize)]
+struct RawSessionPayload<'a> {
+    #[serde(borrow)]
+    segment_id: &'a RawValue,
+}
