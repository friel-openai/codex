+    drop(retained);
+
+    let _in_process_writer = coordination
+        .writer
+        .try_lock()
+        .expect("final reservation drop must release the same-store writer mutex");
+    let _external_writer = competing
+        .acquire(thread_id)
+        .expect("final reservation drop must release the filesystem writer lock");
