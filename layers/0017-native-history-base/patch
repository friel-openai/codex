+                break;
+            }
+            if matches!(line.item, RolloutItem::RolloutReference(_)) {
+                continue;
+            }
+            let previous_turn_complete = saw_latest_user
+                && matches!(
+                    line.item,
+                    RolloutItem::EventMsg(
