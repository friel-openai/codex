+            != Some("jsonl")
+    {
+        fallback!("thread_archived_or_active_not_plain_jsonl");
+    }
+    if super::helpers::scoped_reference_rollout_path(
+        store.config.codex_home.as_path(),
+        metadata.rollout_path.as_path(),
