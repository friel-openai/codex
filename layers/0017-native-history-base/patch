+        .last()
+        .and_then(|line| line.ordinal)
+        .and_then(|ordinal| ordinal.checked_add(1));
+    if actual_end != Some(position.end_ordinal_exclusive) {
+        return Err(io::Error::other(format!(
+            "history_base ordinal boundary does not match rollout {}",
+            path.display()
+        )));
+    }
