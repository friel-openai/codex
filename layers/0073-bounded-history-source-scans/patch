+/// Verifies the consumed prefix without accepting a concurrent rewrite or replacement.
+fn verify_root_prefix(
+    path: &std::path::Path,
+    snapshot: &RootSnapshot,
+    current: &FileIdentity,
+) -> bool {
+    let Ok(file) = std::fs::File::open(path) else {
+        return false;
+    };
+    let matches_current = || {
+        file.metadata()
+            .ok()
+            .and_then(|meta| file_identity(&meta))
+            .as_ref()
+            == Some(current)
+            && snapshot
+                .file
+                .metadata()
+                .ok()
+                .and_then(|meta| file_identity(&meta))
+                .as_ref()
+                == Some(current)
+            && std::fs::symlink_metadata(path)
+                .ok()
+                .and_then(|meta| file_identity(&meta))
+                .as_ref()
+                == Some(current)
+    };
+    if !matches_current() {
+        return false;
+    }
+    let mut reader = (&file).take(snapshot.identity.size());
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 64 * 1024];
+    let mut read = 0_u64;
+    loop {
+        let Ok(count) = reader.read(&mut buffer) else {
+            return false;
+        };
+        if count == 0 {
+            break;
+        }
+        read += count as u64;
+        digest.update(&buffer[..count]);
+    }
+    read == snapshot.identity.size()
+        && <[u8; 32]>::from(digest.finalize()) == snapshot.digest
+        && matches_current()
 }

