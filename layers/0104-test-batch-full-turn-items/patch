+fn source_turns_preserve_inherited_abort_and_distinct_reused_turn() {
+    let parent = ThreadId::new();
+    let child = ThreadId::new();
+    let segment = RolloutLineageSegment {
+        thread_id: child,
+        rollout_id: child,
+        segment_id: None,
