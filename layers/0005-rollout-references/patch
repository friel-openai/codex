+}
+
+async fn assert_indexed_paginated_fork_rollout_file_opens_are_bounded(
+    source: IndexedForkSource,
+) -> Result<()> {
+    for segment_count in [8, 32, 128] {
+        for presentation in [
+            IndexedForkPresentation::Durable,
+            IndexedForkPresentation::Ephemeral,
+        ] {
+            let file_open_count =
