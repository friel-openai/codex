+fn collect_bounded_dirs_desc<T, F>(
+    parent: &Path,
+    parse: F,
+    scan: &BoundedCandidateScan,
+) -> io::Result<Vec<(T, PathBuf)>>
+where
+    T: Ord + Copy,
+    F: Fn(&str) -> Option<T>,
+{
+    scan.check_cancelled()?;
+    let mut directories = Vec::new();
+    for entry in std::fs::read_dir(parent)? {
+        scan.check_cancelled()?;
+        let entry = entry?;
+        if !entry.file_type().is_ok_and(|file_type| file_type.is_dir()) {
+            continue;
+        }
+        let Some(value) = entry.file_name().to_str().and_then(&parse) else {
+            continue;
+        };
+        directories.push((value, entry.path()));
+    }
+    directories.sort_by_key(|(value, _)| Reverse(*value));
+    Ok(directories)
+}
