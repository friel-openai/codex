+//! Strict resolution and materialization of rollout-reference graphs.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs::Metadata;
+use std::io;
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
