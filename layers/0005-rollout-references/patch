+async fn cursor_belongs_to_requested_projection(
+    pool: &sqlx::SqlitePool,
+    requested_thread_id: ThreadId,
+    scope: CursorScope,
+    cursor: Option<&HistoryCursor>,
+) -> ThreadStoreResult<bool> {
+    let Some(cursor) = cursor else {
