+    /// A fork is not published to its caller until its inherited history is durable.
+    /// Failed persistence must not leave a registered runtime owning the child writer.
+    pub(crate) async fn flush_fork_or_shutdown(&self, new_thread: &NewThread) -> CodexResult<()> {
+        let Err(error) = new_thread.thread.flush_rollout().await else {
+            return Ok(());
+        };
+        if let Err(shutdown_error) = new_thread.thread.shutdown_and_wait().await {
+            warn!(
+                thread_id = %new_thread.thread_id,
+                "failed to shut down fork after persistence failure: {shutdown_error}"
+            );
+        }
+        let mut threads = self.threads.write().await;
+        if threads
+            .get(&new_thread.thread_id)
+            .is_some_and(|thread| Arc::ptr_eq(thread, &new_thread.thread))
+        {
+            // Shutdown logs persistence errors, so release any writer left by a failed
+            // recorder shutdown. Exclude a concurrent resume from replacing this writer.
+            // Discard does not remove the persisted rollout.
+            if let Some(live_thread) = new_thread.thread.session.live_thread()
+                && let Err(discard_error) = live_thread.discard().await
+                && !matches!(discard_error, ThreadStoreError::ThreadNotFound { .. })
+            {
+                warn!(
+                    thread_id = %new_thread.thread_id,
+                    "failed to discard fork writer after persistence failure: {discard_error}"
+                );
+            }
+            threads.remove(&new_thread.thread_id);
+        }
+        Err(error.into())
+    }
