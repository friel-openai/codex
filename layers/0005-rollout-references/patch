+async fn bounded_paginated_fork_preserves_latest_multi_agent_version(
+    resume_parent: bool,
+) -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    let fixture_home = TempDir::new()?;
+    for home in [&codex_home, &fixture_home] {
+        MockResponsesConfig::new(&server.uri())
+            .disable_feature(Feature::MultiAgentV2)
+            .write(home.path())?;
+    }
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(fixture_home.path())
+        .build_initialized()
+        .await?;
+    let parent = mcp
+        .start_thread(ThreadStartParams {
+            history_mode: Some(ThreadHistoryMode::Paginated),
+            ..Default::default()
+        })
+        .await?
+        .thread;
+    let mut turn_ids = Vec::new();
+    for text in ["included versioned source", "excluded versioned source"] {
+        let completed = mcp
+            .start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: parent.id.clone(),
+                input: vec![UserInput::Text {
+                    text: text.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            })
+            .await?;
+        turn_ids.push(completed.turn.id);
+    }
+    mcp.shutdown_gracefully().await?;
+
+    // Old session metadata can omit the version while a later TurnContext selects V2.
+    // The requested fork prefix retains V1, so version recovery must use the full source.
+    let recorded_path = parent.path.as_ref().expect("parent rollout");
+    let (mut source_lines, ..) =
+        RolloutRecorder::load_rollout_lines(recorded_path.as_path()).await?;
+    let mut context_versions = Vec::new();
+    for line in &mut source_lines {
+        match &mut line.item {
+            RolloutItem::SessionMeta(meta) => meta.meta.multi_agent_version = None,
+            RolloutItem::TurnContext(context) => {
+                let version = if context.turn_id.as_ref() == Some(&turn_ids[0]) {
+                    MultiAgentVersion::V1
+                } else {
+                    assert_eq!(context.turn_id.as_ref(), Some(&turn_ids[1]));
+                    MultiAgentVersion::V2
+                };
+                context.multi_agent_version = Some(version);
+                context_versions.push(version);
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(
+        context_versions,
+        vec![MultiAgentVersion::V1, MultiAgentVersion::V2]
+    );
+    let fixture = source_lines
+        .iter()
+        .map(serde_json::to_string)
+        .collect::<Result<Vec<_>, _>>()?
+        .join("\n");
+    // Do not reuse byte-offset projections recorded before the fixture rewrite.
+    let source_path = codex_home
+        .path()
+        .join(recorded_path.as_path().strip_prefix(fixture_home.path())?);
+    std::fs::create_dir_all(source_path.parent().expect("rollout directory"))?;
+    std::fs::write(source_path.as_path(), format!("{fixture}\n"))?;
+    mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    if resume_parent {
+        let _: ThreadResumeResponse = mcp
+            .request(|request_id| ClientRequest::ThreadResume {
+                request_id,
+                params: ThreadResumeParams {
+                    thread_id: parent.id.clone(),
+                    exclude_turns: true,
+                    ..Default::default()
+                },
+            })
+            .await?;
+    }
+    assert_eq!(
+        read_session_meta_line(source_path.as_path())
+            .await?
+            .meta
+            .multi_agent_version,
+        None
+    );
+    let source_before_forks = std::fs::read_to_string(source_path.as_path())?;
+    let mut children = Vec::new();
+    for (last_turn_id, before_turn_id) in [
+        (Some(turn_ids[0].clone()), None),
+        (None, Some(turn_ids[1].clone())),
+    ] {
+        for exclude_turns in [false, true] {
+            let ThreadForkResponse { thread: child, .. } = mcp
+                .request(|request_id| ClientRequest::ThreadFork {
+                    request_id,
+                    params: ThreadForkParams {
+                        thread_id: parent.id.clone(),
+                        last_turn_id: last_turn_id.clone(),
+                        before_turn_id: before_turn_id.clone(),
+                        exclude_turns,
+                        approval_policy: Some(AskForApproval::Never),
+                        approvals_reviewer: Some(ApprovalsReviewer::User),
+                        sandbox: Some(SandboxMode::ReadOnly),
+                        ..Default::default()
+                    },
+                })
+                .await?;
+            assert_eq!(
+                child.turns.iter().map(|turn| &turn.id).collect::<Vec<_>>(),
+                if exclude_turns {
+                    Vec::new()
+                } else {
+                    vec![&turn_ids[0]]
+                }
+            );
+            assert_eq!(
+                read_session_meta_line(child.path.as_ref().expect("fork rollout").as_path())
+                    .await?
+                    .meta
+                    .multi_agent_version,
+                Some(MultiAgentVersion::V2),
+                "fork version must survive lastTurnId={last_turn_id:?}, beforeTurnId={before_turn_id:?}, excludeTurns={exclude_turns}"
+            );
+            assert_eq!(
+                std::fs::read_to_string(source_path.as_path())?,
+                source_before_forks,
+                "forking must not rewrite source version metadata or history"
+            );
+            mcp.start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: child.id.clone(),
+                input: vec![UserInput::Text {
+                    text: "first fork request".to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            })
+            .await?;
+            children.push(child);
+        }
+    }
+    mcp.shutdown_gracefully().await?;
+    mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    // One restart covers persistence; every fork above already checked its stored version.
+    for child in children.into_iter().take(1) {
+        let _: ThreadResumeResponse = mcp
+            .request(|request_id| ClientRequest::ThreadResume {
+                request_id,
+                params: ThreadResumeParams {
+                    thread_id: child.id.clone(),
+                    exclude_turns: true,
+                    ..Default::default()
+                },
+            })
+            .await?;
+        assert_eq!(
+            read_session_meta_line(child.path.as_ref().expect("fork rollout").as_path())
+                .await?
+                .meta
+                .multi_agent_version,
+            Some(MultiAgentVersion::V2)
+        );
+        mcp.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: child.id,
+            input: vec![UserInput::Text {
+                text: "resumed fork request".to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    }
+    let requests = server.received_requests().await.expect("response requests");
+    let child_requests = requests
+        .iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .skip(2)
+        .collect::<Vec<_>>();
+    assert_eq!(child_requests.len(), 5);
+    for request in child_requests {
+        let body = request.body_json::<Value>()?;
+        let namespaces = body["tools"]
+            .as_array()
+            .expect("tools")
+            .iter()
+            .filter_map(|tool| tool["name"].as_str())
+            .filter(|name| matches!(*name, "collaboration" | "multi_agent_v1"))
+            .collect::<Vec<_>>();
+        assert_eq!(namespaces, vec!["collaboration"]);
+        let input = serde_json::to_string(&body["input"])?;
+        assert!(input.contains("included versioned source"));
+        assert!(!input.contains("excluded versioned source"));
+    }
+    Ok(())
+}
