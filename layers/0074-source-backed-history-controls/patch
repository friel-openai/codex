+#[tokio::test]
+async fn source_history_preserves_attached_visibility() {
+    for attached in [false, true] {
+        let (home, store, child) = store_with_mode(ThreadHistoryMode::Paginated).await;
+        let parent = ThreadId::new();
+        let parent_path = rollout_path(home.path(), parent);
+        write_rollout(&parent_path, parent, None);
+        let started = |id: &str| {
+            RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+                turn_id: id.to_string(),
+                root_turn_id: None,
+                turn_attribution: None,
+                trace_id: None,
+                started_at: Some(10),
+                model_context_window: None,
+                collaboration_mode_kind: Default::default(),
+            }))
+        };
+        append_timeline_record(&parent_path, 1, started("parent-turn"));
+        append_timeline_record(
+            &parent_path,
+            2,
+            timeline_user_item(parent, "parent-turn", "parent-item", "parent text"),
+        );
+        let child_path = rollout_path(home.path(), child);
+        write_rollout(
+            &child_path,
+            child,
+            Some(history_position(&parent_path, parent, 3)),
+        );
+        let mut lines = codex_rollout::RolloutRecorder::load_rollout_lines(&child_path)
+            .await
+            .unwrap()
+            .0;
+        let RolloutItem::SessionMeta(meta) = &mut lines[0].item else {
+            panic!("child must start with metadata");
+        };
+        meta.meta.attached_thread = attached;
+        meta.meta.forked_from_id = Some(parent);
+        meta.meta.forked_from_ordinal_exclusive = Some(3);
+        fs::write(
+            &child_path,
+            format!("{}\n", serde_json::to_string(&lines[0]).unwrap()),
+        )
+        .unwrap();
+        append_timeline_record(&child_path, 4, started("child-turn"));
+        append_timeline_record(
+            &child_path,
+            5,
+            timeline_user_item(child, "child-turn", "child-item", "child text"),
+        );
+
+        let turns = store
+            .list_turns(turn_params(
+                child,
+                None,
+                10,
+                SortDirection::Asc,
+                StoredTurnItemsView::NotLoaded,
+            ))
+            .await
+            .unwrap();
+        let items = store
+            .list_items(item_params(child, None, None, 10, SortDirection::Asc))
+            .await
+            .unwrap();
+        if attached {
+            assert_eq!(turn_ids(&turns), ["child-turn"]);
+            assert_eq!(item_ids(&items), ["child-item"]);
+        } else {
+            assert_eq!(turn_ids(&turns), ["parent-turn", "child-turn"]);
+            assert_eq!(item_ids(&items), ["parent-item", "child-item"]);
+        }
+    }
+}
