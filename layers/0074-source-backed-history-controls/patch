+#[tokio::test]
+async fn missing_predecessor_cannot_determine_descending_parent_page() {
+    let (home, store, child) = store_with_mode(ThreadHistoryMode::Paginated).await;
+    let parent = ThreadId::new();
+    let predecessor_id = ThreadId::new();
+    let predecessor = selected_rollout_path(home.path(), parent, predecessor_id);
+    let started = |id: &str| {
+        RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: id.to_string(),
+            root_turn_id: None,
+            turn_attribution: None,
+            trace_id: None,
+            started_at: Some(10),
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }))
+    };
+    write_rollout(&predecessor, parent, None);
+    append_timeline_record(&predecessor, 1, started("shared"));
+    let parent_path = rollout_path(home.path(), parent);
+    write_rollout(
+        &parent_path,
+        parent,
+        Some(history_position(&predecessor, predecessor_id, 2)),
+    );
+    append_timeline_record(&parent_path, 3, started("middle"));
+    append_timeline_record(&parent_path, 4, started("shared"));
+    let child_path = rollout_path(home.path(), child);
+    write_rollout(
+        &child_path,
+        child,
+        Some(history_position(&parent_path, parent, 5)),
+    );
+    append_timeline_record(&child_path, 6, started("child"));
+    let params = turn_params(
+        child,
+        None,
+        2,
+        SortDirection::Desc,
+        StoredTurnItemsView::NotLoaded,
+    );
+
+    let first = store.list_turns(params.clone()).await.unwrap();
+    assert_eq!(turn_ids(&first), ["child", "middle"]);
+    let predecessor_before = fs::read_to_string(&predecessor).unwrap();
+    let parent_before = fs::read(&parent_path).unwrap();
+    let child_before = fs::read(&child_path).unwrap();
+    fs::remove_file(&predecessor).unwrap();
+    assert!(matches!(
+        store.list_turns(params.clone()).await,
+        Err(ThreadStoreError::Conflict { .. })
+    ));
+
+    // The same predecessor boundary can describe a different turn start. Without
+    // that source, neither the parent nor child determines which page is correct.
+    let predecessor_after = predecessor_before.replace("shared", "otherx");
+    assert_ne!(predecessor_before, predecessor_after);
+    assert_eq!(predecessor_before.len(), predecessor_after.len());
+    fs::write(&predecessor, predecessor_after).unwrap();
+    assert_eq!(fs::read(&parent_path).unwrap(), parent_before);
+    assert_eq!(fs::read(&child_path).unwrap(), child_before);
+    let second = store.list_turns(params).await.unwrap();
+    assert_eq!(turn_ids(&second), ["child", "shared"]);
+}
