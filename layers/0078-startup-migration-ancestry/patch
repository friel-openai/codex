+
+    let unique_id = ThreadId::new();
+    write_rollout(home.path(), unique_id, ThreadHistoryMode::Paginated);
+    let mut unique_descendants = Vec::new();
+    for _ in 0..2 {
+        let path = write_rollout(home.path(), ThreadId::new(), ThreadHistoryMode::Paginated);
