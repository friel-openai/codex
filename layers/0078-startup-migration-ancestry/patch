+    pub(super) source_reads: usize,
+    pub(super) walk_steps: usize,
+    pub(super) source_validations: usize,
+}
+
+impl LineageInspectionCache {
+    fn clear(&mut self) {
+        self.paths = None;
+        self.sources.clear();
+        self.nodes.clear();
+    }
+
+    #[cfg(test)]
+    pub(super) fn stats(&self) -> &LineageInspectionStats {
+        &self.stats
