+    let pause = uncertified_items::inject_index_pause(thread_id);
+    let mut requests = Vec::new();
+    for _ in 0..5 {
+        let store = store.clone();
+        requests.push(tokio::spawn(async move {
+            store
+                .list_items(item_params(
+                    thread_id,
+                    Some("turn"),
+                    None,
+                    1,
+                    SortDirection::Desc,
