+    fs::write(
+        &compressed,
+        zstd::stream::encode_all(fs::read(&old_root).unwrap().as_slice(), 0).unwrap(),
+    )
+    .unwrap();
+    fs::remove_file(&old_root).unwrap();
+
+    let middle_id = ThreadId::new();
+    let middle = selected_rollout_path(home.path(), thread_id, middle_id);
