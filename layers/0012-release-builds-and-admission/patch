+            "1.2.3+frodex.0",
+            "a" * 40,
+            "linux-x86_64",
+        )
+        self.assertEqual(digest, hashlib.sha256(archive.read_bytes()).hexdigest())
+        self.assertEqual(size, archive.stat().st_size)
