+        .join(original_segment_id.to_string())
+        .join(
+            rollout_path
+                .file_name()
+                .context("rollout path must have a file name")?,
+        );
+    assert_eq!(std::fs::read(immutable_backup)?, original);
+    assert!(!codex_home.path().join("thread_history_2.sqlite").exists());
+    assert!(
