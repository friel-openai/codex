+impl Drop for LeaseInner {
+    fn drop(&mut self) {
+        if !self.released.swap(true, Ordering::AcqRel) && self.slot.release() {
+            self.slot.current().client.request_router.close();
+            self.slot.current().client.cancel_token.cancel();
+        }
+    }
