+            .sum::<usize>();
+        assert_eq!(
+            tool_definition_json_bytes(observed_tools(), true),
+            expected_bytes
+        );
+        assert_eq!(visited.get(), tools.len());
+        assert!(expected_bytes > 0);
+    }
+}
