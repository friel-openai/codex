+    pub(crate) async fn authentication_failed(&self) -> bool {
+        let Ok(connection) = self.current() else {
+            return false;
+        };
+        if !connection.client.startup_complete.load(Ordering::Acquire) {
+            return false;
+        }
+        connection
+            .client
+            .client
+            .clone()
+            .await
+            .is_err_and(|error| error.is_authentication_required())
+    }
