+    let helper_thread = harness
+        .manager
+        .get_thread(helper_thread_id)
+        .await
+        .expect("supervisor helper thread should be registered");
+    assert_eq!(
+        helper_thread.session.prompt_cache_key(),
+        parent_thread.session.prompt_cache_key(),
