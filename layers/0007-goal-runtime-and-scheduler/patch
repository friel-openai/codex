+    }
+
+    pub fn start_with_options(
+        state_db: Arc<StateRuntime>,
+        activator: GoalActivator,
+        options: GoalSchedulerOptions,
+    ) -> Self {
+        let task = tokio::spawn(run_scheduler(state_db, activator, options));
+        Self { task }
+    }
+
+    pub fn stop(&self) {
+        self.task.abort();
+    }
