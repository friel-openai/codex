+impl LocalAgentControl {
+    async fn inherited_instructions_for_resume(
+        &self,
+        state: &ThreadManagerState,
+        thread_id: ThreadId,
+        session_source: &SessionSource,
+        parent_thread_id: Option<ThreadId>,
+    ) -> Option<SessionInstructions> {
+        if let Some(instructions) = self.state.evicted_instructions(thread_id) {
+            return Some(instructions);
+        }
+        if !session_source.is_non_root_agent() {
+            return None;
+        }
+        if let Some(parent_thread_id) = session_source.parent_thread_id().or(parent_thread_id)
+            && let Ok(parent) = state.get_thread(parent_thread_id).await
+        {
+            return Some(parent.session.inherited_instructions().await);
+        }
+        self.shared_thread_instructions_provider
+            .get()
+            .map(|provider| SessionInstructions {
+                thread_provider: Some(Arc::clone(provider)),
+                ..Default::default()
+            })
+    }
