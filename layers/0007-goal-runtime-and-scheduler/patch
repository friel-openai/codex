+fn recording_activator(tx: mpsc::UnboundedSender<ActiveGoalSupervisorSchedule>) -> GoalActivator {
+    Arc::new(move |schedule| {
+        let tx = tx.clone();
+        Box::pin(async move {
+            tx.send(schedule)
+                .map_err(|_| "activation receiver closed".to_string())
+        })
+    })
+}
