+/// Whether rollback must leave the original root running or persisted but unloaded.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum OriginalRootResidency {
+    Loaded,
+    Cold,
+}
+
+/// Original root ownership and configuration required for adoption rollback.
+struct OriginalRoot {
+    control: LocalAgentControl,
+    config: Config,
+    source: SessionSource,
+    residency: OriginalRootResidency,
+    /// Applied instructions captured before unloading a live root.
+    instructions: Option<SessionInstructions>,
+    /// Transition lock retained by callers waiting across an ownership transfer.
+    lifecycle: Option<Arc<AgentLifecycle>>,
+}
