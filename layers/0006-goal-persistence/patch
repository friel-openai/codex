+        "#,
+    )
+    .fetch_all(&mut *state_transaction)
+    .await?;
+    thread_goals
+        .upsert_frodex_goal_supervisor_state_rows(supervisor_rows)
+        .await?;
+    sqlx::query("DROP TABLE thread_goal_supervisor_state")
+        .execute(&mut *state_transaction)
+        .await
