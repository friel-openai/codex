+        assert_eq!(resumed.thread.history_mode, ThreadHistoryMode::Paginated);
+        let visible =
+            read_public_history_projection(&mut app, thread_id, DEFAULT_READ_TIMEOUT).await?;
+        assert!(
+            visible
