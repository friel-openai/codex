+                .any(|(_, _, item)| String::from_utf8_lossy(item).contains("inherited user"))
+        );
+        timeout(
+            DEFAULT_READ_TIMEOUT,
+            app.start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: thread_id.to_string(),
+                input: vec![UserInput::Text {
