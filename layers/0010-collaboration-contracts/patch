+        .await?;
+
+    let requests = responses.requests();
+    let output_request = requests
+        .get(1)
+        .expect("tool outputs should be submitted in a second request");
+    let actual = calls
+        .iter()
+        .map(|(call_id, tool_name, arguments)| {
