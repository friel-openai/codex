+fn search_manifest(info: codex_tools::ToolSearchInfo) -> Value {
+    json!({
+        "search_text": info.entry.search_text,
+        "output": info.entry.to_loadable_spec(),
+        "source": info.source_info.map(|source| json!({
+            "name": source.name,
+            "description": source.description,
+        })),
+    })
+}
