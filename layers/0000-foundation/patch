+/// Changes to the completed parent response's identity before a child preconnects.
+#[derive(Clone, Copy)]
+enum ForkContinuationIdentity {
+    Unchanged,
+    AuthOwnerChanged,
+    RouteChanged,
+    RouteMissing,
+    RuntimeChanged,
+    GuardianAffinityChanged,
+    HeadersChanged,
+}
