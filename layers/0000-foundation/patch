+    fs::create_dir_all(curated_root.join(".agents/plugins"))?;
+    fs::write(
+        curated_root.join(".agents/plugins/marketplace.json"),
+        format!(
+            r#"{{
+  "name": "{OPENAI_CURATED_MARKETPLACE_NAME}",
+  "plugins": [
+{marketplace_plugin}
+  ]
+}}"#
+        ),
+    )?;
+    fs::create_dir_all(plugin_root.join(".codex-plugin"))?;
+    fs::write(
